###############
# NAME FORMATS
###############

# A note on random naming in the empire designer when the player as not yet selected planet, system, and/or gov:
# You must use the special country scoped GetCapitalPlanetNameOrRandom and GetCapitalSystemNameOrRandom here
# instead of Capital.GetName and Capital.System.GetName to deal with these being potentially unspecified.
# Furthermore, the has_government trigger has special behavior in this context and will return yes/true if the
# government has not been specified yet.

### Imperial Militarist

# Imperial Militarist 1
empire_name_format = {
	random_weight = {
		factor = 0
		modifier = {
			add = 100000
			OR = {
				has_government = "gov_star_empire"
				has_government = "gov_martial_empire"
			}
			is_pirate = no
			is_primitive = no
			is_nomadic = no
			NOT = { is_country_type = fallen_empire }
			NOT = { is_country_type = awakened_fallen_empire }
		}
	}
	format = "{AofB{<imperial_mil_rinfix> [This.GetCapitalSystemNameOrRandom]}}"
	prefix_format = "{AofBpfx{[This.GetCapitalSystemNameOrRandom] <imperial_mil_rinfix>}}"
	noun = "{[This.GetCapitalSystemNameOrRandom]}"
	# Империя Солнца
}

