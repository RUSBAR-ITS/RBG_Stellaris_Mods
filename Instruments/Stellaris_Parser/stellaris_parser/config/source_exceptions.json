{
  "format_version": 1,
  "rules": [
    {
      "id": "sttv_willpower_political_power_separator",
      "kind": "missing_library_block_separator",
      "match": {
        "root_files": ["common/scripted_effects/forceofwill_scripted_effects.txt"],
        "field": "increase_pop_political_power"
      },
      "reason": "Stellaris 4.6.0 omits the assignment operator before this top-level effect body."
    },
    {
      "id": "sttv_willpower_relocation_default",
      "kind": "missing_parameter",
      "match": {
        "root_files": ["events/forceofwill_events.txt"],
        "call_kind": "scripted_effect",
        "definition_file": "common/scripted_effects/forceofwill_scripted_effects.txt",
        "call_name": "move_galactic_halls",
        "reference": "$IS_FROM_RELOCATE$",
        "missing_parameter": "IS_FROM_RELOCATE",
        "required_parameters": ["OWNER", "PLANET"]
      },
      "action": {"parameter_literal": "no"},
      "reason": "Use the existing militarist branch default when the event omits the relocation argument."
    },
    {
      "id": "sttv_event_job_amenities_separator",
      "kind": "script_value_reference",
      "match": {
        "root_files": [
          "common/pop_jobs/06_event_jobs.txt"
        ],
        "file": "common/pop_jobs/06_event_jobs.txt",
        "scalar": "value:scripted_modifier_mult|MODIFIER|pop_job_amenities_mult||"
      },
      "action": {
        "replace_scalar": "value:scripted_modifier_mult|MODIFIER|pop_job_amenities_mult|"
      },
      "reason": "Remove one extra trailing separator from the confirmed reference during import."
    },
    {
      "id": "sttv_archive_selected_relic",
      "kind": "missing_parameter",
      "match": {
        "root_files": [
          "events/grand_archive_events.txt",
          "events/leviathans_events_1.txt"
        ],
        "call_kind": "inline_script",
        "definition_file": "common/inline_scripts/grand_archive/collection/stage_3_reward_option.txt",
        "reference": "gave_relic_$RELIC$",
        "missing_parameter": "RELIC",
        "required_parameters": [
          "SELECTED_RELIC"
        ]
      },
      "action": {
        "parameter_from": "SELECTED_RELIC"
      },
      "reason": "Bind the missing RELIC parameter to the selected relic already supplied by the caller."
    },
    {
      "id": "sttv_nomads_ethic_random",
      "kind": "missing_parameter",
      "match": {
        "root_files": [
          "events/nomads_origin_events.txt"
        ],
        "call_kind": "scripted_effect",
        "definition_file": "common/scripted_effects/00_scripted_effects.txt",
        "call_name": "pop_group_add_ethic_effect",
        "reference": "$RANDOM$",
        "missing_parameter": "RANDOM",
        "required_parameters": [
          "POP_GROUP",
          "ETHOS",
          "PERCENTAGE"
        ]
      },
      "action": {
        "parameter_literal": "0"
      },
      "reason": "Supply the user-approved temporary RANDOM value of zero for the affected nomad calls."
    },
    {
      "id": "sttv_dlc_metadata_store_separator",
      "kind": "missing_assignment_separator",
      "reason": "Approved missing assignment separator in vanilla DLC catalog.",
      "match": {
        "root_files": [
          "dlc_metadata/dlc_info.txt"
        ],
        "containers": [
          "dlcs",
          "dlc002"
        ],
        "field": "paradoxplaza_store_url",
        "value": "\"\""
      },
      "action": {
        "insert": " ="
      }
    },
    {
      "id": "sttv_trait_icon_class",
      "kind": "missing_parameter",
      "match": {
        "root_files": [
          "common/traits/00_admiral_traits.txt",
          "common/traits/00_general_traits.txt",
          "common/traits/00_generic_leader_traits.txt",
          "common/traits/00_governor_traits.txt",
          "common/traits/00_scientist_traits.txt",
          "common/traits/00_special_leader_traits.txt",
          "common/traits/06_distant_stars_traits.txt",
          "common/traits/08_ancrel_traits.txt",
          "common/traits/10_paragon_traits.txt",
          "common/traits/13_machine_age_traits.txt",
          "common/traits/14_grand_archive_traits.txt",
          "common/traits/15_biogenesis_leader_traits.txt",
          "common/traits/16_infernals_traits.txt"
        ],
        "call_kind": "inline_script",
        "definition_file": "common/inline_scripts/trait/icon.txt",
        "reference": "$CLASS$",
        "missing_parameter": "CLASS",
        "required_parameters": []
      },
      "action": {
        "parameter_from_object": {
          "field": "leader_class",
          "allowed_values": [
            "commander",
            "official",
            "scientist"
          ],
          "multiple_literal": "leader"
        }
      },
      "reason": "Derive missing trait icon CLASS from the enclosing trait; use approved leader for multiple classes."
    },
    {
      "id": "sttv_trait_council_icon_class",
      "kind": "missing_parameter",
      "match": {
        "root_files": [
          "common/traits/00_admiral_traits.txt",
          "common/traits/00_general_traits.txt",
          "common/traits/00_generic_leader_traits.txt",
          "common/traits/00_governor_traits.txt",
          "common/traits/00_scientist_traits.txt",
          "common/traits/00_special_leader_traits.txt",
          "common/traits/08_ancrel_traits.txt",
          "common/traits/12_astral_planes_traits.txt",
          "common/traits/16_infernals_traits.txt",
          "common/traits/17_shroud_leader_traits.txt",
          "common/traits/19_forceofwill_leader_traits.txt"
        ],
        "call_kind": "inline_script",
        "definition_file": "common/inline_scripts/trait/icon_element/council_no.txt",
        "reference": "trait/icon_element/council_no_$CLASS$",
        "missing_parameter": "CLASS",
        "required_parameters": []
      },
      "action": {
        "parameter_from_object": {
          "field": "leader_class",
          "allowed_values": [
            "commander",
            "official",
            "scientist"
          ],
          "multiple_literal": "leader"
        }
      },
      "reason": "Derive missing trait icon CLASS from the enclosing trait; use approved leader for multiple classes."
    }
  ]
}
