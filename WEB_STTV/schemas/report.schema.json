          "file": {
            "anyOf": [
              {
                "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
