{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "minimum": 0,
          "type": "integer"
        },
        "skipped_inline_scripts": {
          "minimum": 0,
          "type": "integer"
        },
        "technologies": {
          "minimum": 0,
          "type": "integer"
        },
        "variants": {
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files",
        "technologies",
        "variants",
        "errors",
        "warnings",
        "skipped_inline_scripts"
      ],
      "type": "object"
    },
    "database_written": {
      "type": "boolean"
    },
    "diagnostics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "definition_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "field_path": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "file": {
            "anyOf": [
              {
                "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "source": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stage": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "severity",
          "code",
          "stage",
          "message",
          "source",
          "file",
          "line",
          "definition_id",
          "field_path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format_version": {
      "const": 1
    },
    "generation_report_written": {
      "type": "boolean"
    },
    "registry_written": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "success",
        "failed"
      ]
    }
  },
  "required": [
    "format_version",
    "status",
    "counts",
    "database_written",
    "registry_written",
    "generation_report_written",
    "diagnostics"
  ],
  "type": "object"
}
