        "file": {
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
          "type": "string"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/origin"
          },
          "type": "array"
        },
        "generated_span": {
          "additionalProperties": false,
          "properties": {
            "column": {
              "minimum": 1,
              "type": "integer"
            },
            "end": {
              "minimum": 0,
              "type": "integer"
            },
            "end_column": {
              "minimum": 1,
              "type": "integer"
            },
            "end_line": {
              "minimum": 1,
              "type": "integer"
            },
