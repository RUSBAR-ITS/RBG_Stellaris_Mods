            "end",
            "line",
            "column",
            "end_line",
            "end_column"
          ],
          "type": "object"
        },
        "inline_call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "placeholder": {
          "$ref": "#/$defs/origin"
        },
        "root": {
          "enum": [
            "STELLARIS_ROOT",
            "TECH_PATH",
            "INLINE_SCRIPTS_DIR"
          ]
        },
        "span": {
          "additionalProperties": false,
          "properties": {
            "column": {
              "minimum": 1,
              "type": "integer"
            },
            "end": {
              "minimum": 0,
              "type": "integer"
            },
            "end_column": {
              "minimum": 1,
              "type": "integer"
            },
            "end_line": {
              "minimum": 1,
              "type": "integer"
            },
            "line": {
              "minimum": 1,
              "type": "integer"
            },
            "start": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "start",
            "end",
            "line",
            "column",
            "end_line",
            "end_column"
          ],
          "type": "object"
        }
      },
      "required": [
        "root",
        "file",
        "span",
        "inline_call_id"
