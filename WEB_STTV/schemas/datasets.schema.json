{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "datasets": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "containers": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "descriptorLink": {
            "additionalProperties": false,
            "properties": {
              "localizationField": {
                "minLength": 1,
                "type": "string"
              },
              "matchField": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "matchField",
              "localizationField"
            ],
            "type": "object"
          },
          "directory": {
            "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
            "type": "string"
          },
          "idField": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "identity": {
            "enum": [
              "key",
              "field",
              "anonymous",
              "fragments"
            ]
          },
          "labelId": {
            "minLength": 1,
            "type": "string"
          },
          "recursive": {
            "type": "boolean"
          },
          "rootTypes": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "sourceRoles": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "pattern": {
                  "minLength": 1,
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "objects",
                    "descriptor"
                  ]
                }
              },
              "required": [
                "role",
                "pattern"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "labelId",
          "directory",
          "recursive",
          "rootTypes",
          "identity",
          "idField"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z_]*$",
        "type": "string"
      },
      "type": "object"
    },
    "format_version": {
      "const": 2
    }
  },
  "required": [
    "format_version",
    "datasets"
  ],
  "type": "object"
}
