{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calls": {
      "additionalProperties": {
        "items": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "type": "array"
      },
      "propertyNames": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "type": {
              "const": "documentation"
            }
          },
          "required": [
            "type",
            "sha256",
            "reason"
          ],
          "type": "object"
        },
        "commands_checked": {
          "minimum": 0,
          "type": "integer"
        },
        "diagnostics": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "parsed": {
          "type": "boolean"
        }
      },
      "required": [
        "parsed",
        "commands_checked",
        "diagnostics"
      ],
      "type": "object"
    },
    "format": {
      "const": "sttv.acquisition_document"
    },
    "format_version": {
      "const": 1
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "node": {
            "type": "object"
          },
          "pointer": {
            "minLength": 1,
            "type": "string"
          },
          "record_id": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "source": {
            "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
            "type": "string"
          },
          "type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "id",
          "type",
          "source",
          "pointer",
          "node"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "source": {
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
      "type": "string"
    },
    "targets": {
      "additionalProperties": {
        "items": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "type": "array"
      },
      "propertyNames": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "format",
    "format_version",
    "source",
    "records",
    "targets",
    "calls",
    "coverage"
  ],
  "type": "object"
}
