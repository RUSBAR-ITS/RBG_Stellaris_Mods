{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "excerpt_length": {
      "maximum": 500,
      "minimum": 1,
      "type": "integer"
    },
    "format_version": {
      "const": 1
    },
    "max_examples": {
      "minimum": 1,
      "type": "integer"
    },
    "output": {
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "encoding": {
            "const": "utf-8-sig"
          },
          "game_version": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "engine_documentation",
              "scripted_triggers",
              "inline_scripts"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "pattern": {
            "minLength": 1,
            "type": "string"
          },
          "recursive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "pattern",
          "recursive",
          "encoding",
          "enabled",
          "game_version"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "sources",
    "output",
    "max_examples",
    "excerpt_length"
  ],
  "type": "object"
}
