{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "profile_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "type": "string"
    },
    "registry_path": {
      "minLength": 1,
      "type": "string"
    },
    "registry_written": {
      "type": "boolean"
    }
  },
  "required": [
    "format_version",
    "profile_id",
    "profile_fingerprint",
    "registry_path",
    "registry_written"
  ],
  "type": "object"
}
