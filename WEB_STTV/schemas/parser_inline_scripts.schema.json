{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "encoding": {
      "minLength": 1,
      "type": "string"
    },
    "extension": {
      "pattern": "^\\.[A-Za-z0-9]+$",
      "type": "string"
    },
    "format_version": {
      "const": 1
    },
    "max_depth": {
      "minimum": 1,
      "type": "integer"
    },
    "parameter_case_sensitive": {
      "type": "boolean"
    },
    "path_field": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "path_field",
    "parameter_case_sensitive",
    "extension",
    "encoding",
    "max_depth"
  ],
  "type": "object"
}
