{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "inline_script_files": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "file",
          "reason"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "format_version",
    "inline_script_files"
  ],
  "type": "object"
}
