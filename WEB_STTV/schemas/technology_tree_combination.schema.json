{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "sttv.technology_tree_combination"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "mode": {
      "const": "reference"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "enum": [
            "product",
            "work"
          ]
        },
        "path": {
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
          "type": "string"
        }
      },
      "required": [
        "base",
        "path"
      ],
      "type": "object"
    },
    "variants": {
      "additionalProperties": {
        "pattern": "^(base|swap:[1-9][0-9]*)$",
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "format",
    "format_version",
    "id",
    "mode",
    "profile",
    "variants"
  ],
  "type": "object"
}
