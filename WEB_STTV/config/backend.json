{
  "sources": [
    {
      "variable": "TECH_PATH",
      "pattern": "*.txt",
      "recursive": true,
      "encoding": "utf-8-sig"
    }
  ],
  "parser": {
    "inline_scripts": {
      "base": "product",
      "path": "config/parser/inline_scripts.json"
    },
    "lexical": {
      "base": "product",
      "path": "config/parser/lexical.json"
    },
    "constructs": {
      "base": "product",
      "path": "config/parser/constructs.json"
    },
    "logical_operators": {
      "base": "product",
      "path": "config/parser/logical_operators.json"
    }
  },
  "outputs": {
    "database": "database.json",
    "report": "reports/build_report.json"
  }
}
