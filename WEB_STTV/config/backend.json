  "datasets": {
    "technologies": {
      "sources": [
        {
          "variable": "TECH_PATH",
          "pattern": "*.txt",
          "recursive": true,
          "encoding": "utf-8-sig"
        }
      ],
      "outputs": {
        "database": "databases/technologies.json",
        "report": "reports/technologies_build.json",
        "localization_report": "reports/technologies_localization.json"
      }
    },
