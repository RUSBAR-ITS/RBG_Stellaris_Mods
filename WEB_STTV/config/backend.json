{
  "sources": [
    {
      "variable": "TECH_PATH",
      "pattern": "*.txt",
      "recursive": true,
      "encoding": "utf-8-sig"
    }
  ],
  "parser": {
    "scripted_calls": {
      "base": "product",
      "path": "config/parser/scripted_calls.json"
    },
    "static_variables": {
      "base": "product",
      "path": "config/parser/static_variables.json"
    },
    "exceptions": {
      "base": "product",
      "path": "config/parser/exceptions.json"
    },
    "inline_scripts": {
      "base": "product",
      "path": "config/parser/inline_scripts.json"
    },
    "lexical": {
      "base": "product",
      "path": "config/parser/lexical.json"
    },
    "constructs": {
      "base": "product",
      "path": "config/parser/constructs.json"
    },
    "logical_operators": {
      "base": "product",
      "path": "config/parser/logical_operators.json"
    },
    "script_values": {
      "base": "product",
      "path": "config/parser/script_values.json"
    }
  },
  "outputs": {
    "database": "database.json",
    "report": "reports/build_report.json"
  }
}
