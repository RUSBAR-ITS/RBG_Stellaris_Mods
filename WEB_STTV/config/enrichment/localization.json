{
  "format_version": 3,
  "storage": {
    "base": "product",
    "path": "config/storage.json"
  },
  "languages": {
    "ru": {
      "header": "l_russian",
      "sources": [
        "RU_LOC_TIER_1",
        "RU_LOC_TIER_2",
        "RU_LOC_TIER_3"
      ]
    },
    "en": {
      "header": "l_english",
      "sources": [
        "EN_LOC_TIER_1"
      ]
    }
  },
  "reading": {
    "pattern": "*.yml",
    "recursive": true,
    "encoding": "utf-8-sig"
  },
  "references": {
    "delimiter": "$",
    "key_pattern": "[A-Za-z0-9_.:-]+",
    "max_depth": 64,
    "max_characters": 1000000
  },
  "inherit_description": true,
